{
	"info": {
		"_postman_id": "marvaron-auth-001",
		"name": "MARVRON - Auth APIs",
		"description": "# MARVRON Auth API\n\n## Variables\n| Variable | Use |\n|----------|-----|\n| `base_url` | e.g. `http://localhost:8080` (no trailing slash) |\n| `token` | User JWT (saved after verify-otp / login) |\n| `admin_token` | Admin JWT for role-request moderation |\n| `role_request_id` | UUID from `GET .../role-requests` |\n\n## Flow\n1. **Signup:** `POST .../auth/signup` → OTP emailed (or server logs in dev).\n2. **Verify:** `POST .../auth/signup/verify-otp` → JWT in `token`.\n3. **Login:** `POST .../auth/login` (email verified + registration complete).\n4. **Roles:** `POST .../auth/roles/request` then admin approves via `/admin/role-requests/...`.\n5. **Switch context:** `POST .../auth/switch-role` with an approved role.\n\nDefault role is **`user`**. Elevated roles: `distributor`, `courier`, `vendor` (admin approval).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "admin_token",
			"value": ""
		},
		{
			"key": "role_request_id",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Signup",
			"item": [
				{
					"name": "Signup",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"full_name\": \"Jane Doe\",\n  \"phone\": \"+15551234567\",\n  \"email\": \"jane@example.com\",\n  \"street_address\": \"123 Main St\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"post_code\": \"10001\",\n  \"country\": \"US\",\n  \"password\": \"password123\",\n  \"referral_code\": \"\",\n  \"marketing_opt_in\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/signup",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "signup"]
						},
						"description": "`POST /api/v1/auth/signup`\n\nCreates user (role **user**), sends email OTP. Response: `user_id`, `created_at`."
					}
				},
				{
					"name": "Signup verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) { pm.collectionVariables.set('token', json.token); }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"jane@example.com\",\n  \"otp\": \"000000\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/signup/verify-otp",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "signup", "verify-otp"]
						},
						"description": "`POST /api/v1/auth/signup/verify-otp`\n\nUse OTP from email (dev: server logs). Saves JWT to `token`."
					}
				}
			]
		},
		{
			"name": "Session",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) { pm.collectionVariables.set('token', json.token); }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "`POST /api/v1/auth/login`\n\nRequires verified email and completed registration."
					}
				}
			]
		},
		{
			"name": "Password reset",
			"item": [
				{
					"name": "Forgot password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"jane@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/forgot-password",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "forgot-password"]
						},
						"description": "`POST /api/v1/auth/forgot-password`\n\nSends reset link if account exists. Set `APP_PUBLIC_URL` / SMTP for real email."
					}
				},
				{
					"name": "Reset password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"<paste_token_from_email_query_string>\",\n  \"new_password\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/reset-password",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "reset-password"]
						},
						"description": "`POST /api/v1/auth/reset-password`\n\n`token` from email link (`?token=...`). Valid 1 hour."
					}
				}
			]
		},
		{
			"name": "Profile & account",
			"item": [
				{
					"name": "Get profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "profile"]
						},
						"description": "`GET /api/v1/auth/profile`"
					}
				},
				{
					"name": "Update profile",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"full_name\": \"Jane Q. Doe\",\n  \"phone\": \"+0987654321\",\n  \"street_address\": \"456 Oak Ave\",\n  \"city\": \"Brooklyn\",\n  \"state\": \"NY\",\n  \"post_code\": \"11201\",\n  \"country\": \"US\",\n  \"marketing_opt_in\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "profile"]
						},
						"description": "`PUT /api/v1/auth/profile`"
					}
				},
				{
					"name": "Close account",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/account",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "account"]
						},
						"description": "`DELETE /api/v1/auth/account`"
					}
				}
			]
		},
		{
			"name": "Roles",
			"item": [
				{
					"name": "Request role",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requested_role\": \"distributor\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/roles/request",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "roles", "request"]
						},
						"description": "`POST /api/v1/auth/roles/request`\n\n`requested_role`: `distributor` | `courier` | `vendor`. Admin must approve."
					}
				},
				{
					"name": "Switch active role",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) { pm.collectionVariables.set('token', json.token); }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"active_role\": \"user\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/switch-role",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "switch-role"]
						},
						"description": "`POST /api/v1/auth/switch-role`\n\n`active_role` must already be in your `roles` (e.g. `user`, `distributor`). Returns new JWT."
					}
				}
			]
		},
		{
			"name": "Admin — role requests",
			"description": "Use **Bearer Token** = `{{admin_token}}` on each request (Authorization tab → Type Bearer → `{{admin_token}}`).",
			"item": [
				{
					"name": "List role requests",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.role_requests && json.role_requests.length > 0 && json.role_requests[0].id) {",
									"        pm.collectionVariables.set('role_request_id', json.role_requests[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/role-requests?status=pending",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "admin", "role-requests"],
							"query": [{ "key": "status", "value": "pending" }]
						},
						"description": "`GET /api/v1/admin/role-requests?status=pending`"
					}
				},
				{
					"name": "Approve role request",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/role-requests/{{role_request_id}}/approve",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "admin", "role-requests", "{{role_request_id}}", "approve"]
						},
						"description": "`POST /api/v1/admin/role-requests/:id/approve`"
					}
				},
				{
					"name": "Reject role request",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Optional reason\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/admin/role-requests/{{role_request_id}}/reject",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "admin", "role-requests", "{{role_request_id}}", "reject"]
						},
						"description": "`POST /api/v1/admin/role-requests/:id/reject`"
					}
				}
			]
		},
		{
			"name": "Health",
			"item": [
				{
					"name": "Health check",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "`GET /health`"
					}
				}
			]
		}
	]
}
